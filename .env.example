# Telegram bot (same as your main bot)
BOT_TOKEN=123456:ABC...
BOT_USERNAME=YourBotUsername

# Mini App + API
MINIAPP_URL=https://your-domain.com/
NOVA_API_URL=https://your-domain.com
OPERATION_BOT_SECRET=change-me-long-random
OPERATION_PUBLIC_REWARD=0
API_SESSION_SECRET=change-me-too
CORS_ORIGINS=*
SERVE_FRONTEND=1

# Catalog
TMDB_API_KEY=

# Optional Mongo for sessions
MONGO_URI=
MONGO_DB=nova_movie_hub

# AdsGram (publisher block id for Reward format)
# Set the same value in frontend/scripts/config.js → ADSGRAM_BLOCK_ID
ADSGRAM_BLOCK_ID=
